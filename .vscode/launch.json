{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行 淳朴版 (Naive)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\test_naive.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "d:\\c++\\mingw64\\bin\\gdb.exe",
